{
  "manifest_version": 3,
  "name": "PXV All-in-One",
  "version": "1.2.2",
  "description": "Estiliza, monitora fetch e enriquece thumbnails de ilustrações no Pixiv.",
  "host_permissions": [
    "https://*.pixiv.net/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.pixiv.net/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.pixiv.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css"],
      "matches": ["https://*.pixiv.net/*"]
    }
  ]
}
