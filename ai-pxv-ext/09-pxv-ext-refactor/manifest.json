{
  "manifest_version": 3,
  "name": "Pxtra!",
  "version": "0.5.4",
  "description": "SheetDB with illust, user, tags",
  "host_permissions": [
    "https://*.pixiv.net/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.pixiv.net/*"],
      "js": ["boot.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*"
      ],
      "matches": ["https://*.pixiv.net/*"]
    }
  ]
}
