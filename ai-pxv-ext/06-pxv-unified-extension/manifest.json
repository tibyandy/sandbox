{
  "manifest_version": 3,
  "name": "PXV All-in-One",
  "version": "1.0",
  "description": "Estiliza, monitora fetch e enriquece thumbnails de ilustrações no Pixiv.",
  "host_permissions": ["https://*.pixiv.net/*"],
  "content_scripts": [
    {
      "matches": ["https://*.pixiv.net/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.pixiv.net/*"],
      "js": ["tags-loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.pixiv.net/*"],
      "js": ["observer.js"],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.pixiv.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css", "tags.tsv", "tags-inject.js"],
      "matches": ["https://*.pixiv.net/*"]
    }
  ]
}
