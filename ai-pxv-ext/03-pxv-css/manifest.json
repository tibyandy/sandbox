{
  "manifest_version": 3,
  "name": "PXV SPA Styler & DOM Modifier",
  "version": "1.1",
  "description": "Aplica CSS e executa scripts dinamicamente em SPAs.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.pixiv.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css"],
      "matches": ["*://*.pixiv.net/*"]
    }
  ]
}